# --- Database (self-hosted Postgres via docker compose up -d) ---
DATABASE_URL=postgres://keel_app:keel_app@localhost:5432/keel_trading
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/keel_trading

# --- Redis (rate limiting + WS pub/sub); empty = in-memory fallback ---
REDIS_URL=redis://localhost:6379

# --- API server ---
PORT=3000
NODE_ENV=development

# --- Vault master key (32 bytes base64). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" ---
VAULT_MASTER_KEY=

# --- JWT Ed25519 keys (base64-encoded PEM). Leave empty to auto-generate ephemeral dev keys ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

# --- MFA step-up secret (base32) for /system/mode and /system/credentials ---
MFA_SECRET=

# --- Internal worker HMAC (mTLS terminates at the ingress; HMAC authenticates worker calls app-side) ---
INTERNAL_HMAC_SECRET=

# --- Bootstrap owner (seeded once at boot; ignored after an owner exists) ---
OWNER_EMAIL=owner@local
OWNER_PASSWORD=change-me-now

# --- Binance Spot ---
BINANCE_API_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- EVM / Uniswap V3 ---
EVM_RPC_URL=
UNISWAP_ROUTER_ADDRESS=0x2626664c2603336E57B271c5C0b26F421741e481
UNISWAP_QUOTER_ADDRESS=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a

# --- Solana / Raydium ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
RAYDIUM_AMM_V4_PROGRAM=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Archival (audit records >90 days exported monthly to WORM storage) ---
ARCHIVE_DIR=./data/archive
